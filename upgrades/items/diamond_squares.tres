[gd_resource type="Resource" script_class="SquareChanceUpgrade" format=3]

[ext_resource type="Script" path="res://upgrades/square_chance_upgrade.gd" id="1_upgrade"]
[ext_resource type="Resource" path="res://cubes/squares/diamond_square.tres" id="2_square"]
[ext_resource type="Resource" path="res://cubes/types/blue_cube.tres" id="3_preview"]
[ext_resource type="Script" path="res://shop/goal.gd" id="goal_script"]
[ext_resource type="Resource" path="res://cubes/types/blue_cube.tres" id="goal_cube"]

[sub_resource type="Resource" id="Resource_unlock"]
