[node name="UpgradesPage" type="VBoxContainer" parent="Hud/Root/Sidebar/Panel/VBox/PageScroll/Pages" node_paths=PackedStringArray("tab_button")]
visible = false
layout_mode = 2
theme_override_constants/separation = 4
script = ExtResource("11_page")
items = Array[ExtResource("7_shop_item")]([ExtResource("12_diamond"), ExtResource("14_pickaxe"), ExtResource("48_lucky_strike"), ExtResource("16_big_pickaxe"), ExtResource("21_explosive"), ExtResource("22_blast_radius"), ExtResource("60_coin_pouches"), ExtResource("61_lightning"), ExtResource("62_multiplier"), ExtResource("63_prospector"), ExtResource("51_clean_sweep"), ExtResource("50_steady_hands"), ExtResource("49_hot_streak"), ExtResource("58_lucky_charm"), ExtResource("59_gold_fever"), ExtResource("40_drone"), ExtResource("41_overclock"), ExtResource("42_auto_buyer")])
title = "Upgrades"
toggle_action = &"toggle_upgrades"
notify_when_affordable = true
tab_button = NodePath("../../../../../Tabs/UpgradesTab")

[node name="Tabs" type="VBoxContainer" parent="Hud/Root/Sidebar"]
