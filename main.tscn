[node name="LuckyEvent" type="Node2D" parent="." node_paths=PackedStringArray("fx")]
script = ExtResource("52_lucky_event")
fx = NodePath("../Fx")
frenzies = Array[ExtResource("53_frenzy")]([ExtResource("54_money_frenzy"), ExtResource("55_diamond_frenzy"), ExtResource("56_drone_frenzy")])

[node name="AutoBuyer" type="Node" parent="." node_paths=PackedStringArray("work_area")]
script = ExtResource("44_auto_buyer")
work_area = NodePath("../WorkArea")

[node name="Fx" type="Node2D" parent="." node_paths=PackedStringArray("camera", "hud", "screen_layer", "screen_flash")]
