[node name="Hud" type="CanvasLayer" parent="." node_paths=PackedStringArray("work_area")]
script = ExtResource("5_hud")
work_area = NodePath("../WorkArea")

[node name="Root" type="Control" parent="Hud"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

